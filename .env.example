# ─── VARIÁVEIS DE AMBIENTE — Consultório Dra. Bruna ───────────────────────────
# Copie este arquivo como .env e preencha os valores abaixo
# No Render.com, configure estas variáveis em Environment Variables

# Token de verificação (você define, qualquer texto seguro)
VERIFY_TOKEN=consultorio_dra_bruna

# Token de acesso do WhatsApp Cloud API (obtido no Meta for Developers)
# ATENÇÃO: O token temporário expira em 24h — use o token permanente do System User
WHATSAPP_TOKEN=EAAVTecRo92MBRf81sdWjM5WmrBo8...

# ID do número de telefone (encontrado em Meta for Developers > WhatsApp > Configuração)
PHONE_NUMBER_ID=1142240842304994

# ID do Typebot publicado (encontrado na URL do typebot após publicar)
# Exemplo: https://app.typebot.com/typebots/TYPEBOT_ID/edit
TYPEBOT_ID=cmpenk88600000bj4dhr8hwa7

# Porta do servidor (o Render define automaticamente)
PORT=3000
